# ==============================================================================
# DigitalOcean Production Environment Variables
# ==============================================================================
# Copy this file to .env.production and fill in the values
# DO NOT commit the actual .env.production file with real values!

# Django Settings
# ==============================================================================
DEBUG=0
DJANGO_SECRET_KEY=your-secret-key-here-change-this-to-random-string
ALLOWED_HOSTS=your-app-domain.ondigitalocean.app,yourdomain.com

# Database Configuration
# ==============================================================================
# DigitalOcean will automatically provide DATABASE_URL
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://tabbycat:password@db-host:25060/tabbycat?sslmode=require

# Redis Configuration
# ==============================================================================
# DigitalOcean will automatically provide REDIS_URL from the redis service
REDIS_URL=redis://redis:6379/1
DOCKER_REDIS=1

# Docker/Deployment Settings
# ==============================================================================
IN_DOCKER=1

# Email Configuration (Optional)
# ==============================================================================
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Time Zone
# ==============================================================================
TIME_ZONE=UTC

# Sentry Error Tracking (Optional)
# ==============================================================================
# DISABLE_SENTRY=0
# SENTRY_DSN=your-sentry-dsn-here

# Security Settings
# ==============================================================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Static Files (if using CDN)
# ==============================================================================
# STATIC_URL=https://your-cdn-url.com/static/

# Superuser Creation (for initial setup)
# ==============================================================================
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=secure-password-here
