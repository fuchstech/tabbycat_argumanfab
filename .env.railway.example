# Railway Environment Variables
# Bu dosyayı Railway dashboard'a kopyalayın veya CLI ile ayarlayın

# Django Core Settings
DJANGO_SECRET_KEY=your-super-secret-key-here-change-this
DEBUG=0
IN_DOCKER=1

# Redis
DOCKER_REDIS=1
REDIS_URL=${REDIS_URL}  # Railway otomatik ayarlayacak

# Database
DATABASE_URL=${DATABASE_URL}  # Railway otomatik ayarlayacak

# Timezone (Türkiye için)
TIME_ZONE=Europe/Istanbul

# Admin Email
TAB_DIRECTOR_EMAIL=your-email@example.com

# Sentry (Error Tracking)
# Python 3.6 için ASGI uyumluluğu sorunu var, bu yüzden devre dışı bırakılmalı
DISABLE_SENTRY=1

# Email (Opsiyonel - SendGrid ile)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Allowed Hosts (Railway domain'i otomatik eklenir)
# ALLOWED_HOSTS=your-domain.com,your-app.up.railway.app

# Static Files (Railway için)
DISABLE_COLLECTSTATIC=0
